<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.carstenbund.audiounit.ModalAttractors</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Modal Attractors</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Carsten Bund. All rights reserved.</string>

	<!-- Audio Component Registration -->
	<key>AudioComponents</key>
	<array>
		<dict>
			<!-- Component Type: Music Instrument (aumi) -->
			<key>type</key>
			<string>aumi</string>

			<!-- Component Subtype: Unique 4-character code -->
			<!-- 'mdla' = Modal Attractors -->
			<key>subtype</key>
			<string>mdla</string>

			<!-- Manufacturer: Unique 4-character code -->
			<!-- 'Cbnd' = Carsten Bund -->
			<key>manufacturer</key>
			<string>Cbnd</string>

			<!-- Component Name -->
			<key>name</key>
			<string>Carsten Bund: Modal Attractors</string>

			<!-- Description -->
			<key>description</key>
			<string>Coupled modal oscillator network synthesizer</string>

			<!-- Version -->
			<key>version</key>
			<integer>65536</integer>

			<!-- Factory Function -->
			<key>factoryFunction</key>
			<string>ModalAttractorsAUFactory</string>

			<!-- Sandbox Safe (required for AUv3) -->
			<key>sandboxSafe</key>
			<true/>

			<!-- Tags: Synth, Modal Synthesis -->
			<key>tags</key>
			<array>
				<string>Synth</string>
				<string>Modal</string>
			</array>

			<!-- Resource Usage -->
			<key>resourceUsage</key>
			<dict>
				<key>network.client</key>
				<false/>
				<key>temporary-exception.files.all.read-write</key>
				<false/>
			</dict>
		</dict>
	</array>
</dict>
</plist>
